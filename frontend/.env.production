# En production (Vercel, HTTPS), l'API passe par le proxy défini dans vercel.json :
# /api/* -> http://16.16.210.226:8000/api/* (évite le blocage « Mixed Content »).
VITE_API_URL=/api/
# WebSocket : laisser vide tant que le backend n'est pas en HTTPS (wss://).
# Sans WebSocket, l'app rafraîchit messages et notifications toutes les 6 s.
VITE_WS_URL=
