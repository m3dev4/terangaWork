SECRET_KEY=django-insecure-change-me
# Local : DEBUG=True. Production : DEBUG=False (sinon le serveur affiche le code en cas d'erreur).
# Avec DEBUG=False, le serveur refuse de démarrer si la clé interne, le secret n8n
# ou ALLOWED_HOSTS ne sont pas correctement configurés.
DEBUG=True
# Production : le domaine de l'API, sans "*" (ex. 16-16-210-226.sslip.io)
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://teranga-work.vercel.app

# Resend Email Service
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL="TerangaWork <no-reply@votredomaine.com>"

# Cloudinary
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret

# Microservice FastAPI Matching Intelligent
FASTAPI_MATCHING_URL=http://localhost:8000
# Clé partagée Django <-> FastAPI : 32 caractères minimum, à générer avec
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# La même valeur doit être mise dans ia/.env (INTERNAL_API_KEY et DJANGO_INTERNAL_API_KEY).
FASTAPI_INTERNAL_API_KEY=

# URL publique du frontend (liens dans les e-mails, retour PayDunya)
# En production : https://teranga-work.vercel.app
FRONTEND_URL=http://localhost:5173
PAYDUNYA_RETURN_BASE_URL=http://localhost:5173/espace/projets

# n8n — utiliser les URLs de PRODUCTION (/webhook/...), workflows activés.
# Les URLs /webhook-test/ ne répondent que lorsque l'éditeur n8n est ouvert.
N8N_DESCRIPTION_WEBHOOK_URL=
N8N_MODERATION_WEBHOOK_URL=
# Secret envoyé par n8n dans l'en-tête X-N8N-Secret lors du retour de modération.
# Obligatoire en production ; sans lui, seule la modération par un admin fonctionne.
N8N_MODERATION_SECRET=

# PayDunya
PAYDUNYA_MODE=test
# Simulation du décaissement : uniquement pour les tests, jamais en production.
# Toujours ignorée quand PAYDUNYA_MODE=live.
PAYDUNYA_SIMULATE_DISBURSEMENT=False
