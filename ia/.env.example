INTERNAL_API_KEY=your-secret-internal-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=google/gemini-2.5-flash
LOG_LEVEL=INFO

# ────────────────────────────────────────────────────
# CHATBOT / Assistant conversationnel (ajoutés Jëfly)
# ────────────────────────────────────────────────────

# Base URL du backend Django, racine de l'API (sans /api/ final).
# Le microservice IA appelle Django via ça pour récupérer les DONNÉES AUTORISÉES.
DJANGO_BASE_URL=http://localhost:8000/api

# Clé secrète partagée Django ↔ FastAPI (DOIT correspondre à FASTAPI_INTERNAL_API_KEY du backend).
# Utilisée dans le header X-Internal-API-Key pour sécuriser /chat/data/*.
DJANGO_INTERNAL_API_KEY=your-secret-internal-api-key

# Modèle Hugging Face utilisé pour le chat (via AsyncInferenceClient.chat.completions.create).
# Exemples : mistralai/Mistral-7B-Instruct-v0.3, meta-llama/Llama-3-8B-Instruct, etc.
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# Timeout (en secondes) pour l'appel au modèle Hugging Face.
HF_TIMEOUT=30.0
